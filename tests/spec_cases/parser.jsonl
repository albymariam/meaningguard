{"id": "parser-001", "area": "parser", "lang": "en", "input": "The price fell from ₹500 to ₹400.", "expect": {"tier": 1, "facts": [{"kind": "CHANGE", "direction": "FALL", "from": {"type": "MONEY", "amount": "500", "currency": "INR"}, "to": {"type": "MONEY", "amount": "400", "currency": "INR"}}]}, "must": "pass", "rule": "C-DIR"}
{"id": "parser-002", "area": "parser", "lang": "en", "input": "The price rose from ₹400 to ₹500.", "expect": {"tier": 1, "facts": [{"kind": "CHANGE", "direction": "RISE", "from": {"type": "MONEY", "amount": "400", "currency": "INR"}, "to": {"type": "MONEY", "amount": "500", "currency": "INR"}}]}, "must": "pass", "rule": "C-DIR"}
{"id": "parser-003", "area": "parser", "lang": "en", "input": "Sales increased by 12%.", "expect": {"tier": 1, "facts": [{"kind": "CHANGE", "direction": "RISE", "from": null, "to": null, "delta": {"type": "PERCENT", "amount": "12"}}]}, "must": "pass", "rule": "C-DIR"}
{"id": "parser-004", "area": "parser", "lang": "en", "input": "Deposit between ₹5 lakh and ₹10 lakh.", "expect": {"tier": 1, "facts": [{"kind": "RANGE", "low": {"type": "MONEY", "amount": "500000", "currency": "INR"}, "high": {"type": "MONEY", "amount": "1000000", "currency": "INR"}}]}, "must": "pass", "rule": "C-RANGE"}
{"id": "parser-005", "area": "parser", "lang": "en", "input": "Pay more than ₹500.", "expect": {"tier": 1, "facts": [{"kind": "BOUND", "op": "GT", "value": {"type": "MONEY", "amount": "500", "currency": "INR"}}]}, "must": "pass", "rule": "C-BOUND"}
{"id": "parser-006", "area": "parser", "lang": "en", "input": "Pay at least ₹500.", "expect": {"tier": 1, "facts": [{"kind": "BOUND", "op": "GTE", "value": {"type": "MONEY", "amount": "500", "currency": "INR"}}]}, "must": "pass", "rule": "C-BOUND"}
{"id": "parser-007", "area": "parser", "lang": "en", "input": "Pay up to 5 lakh rupees.", "expect": {"tier": 1, "facts": [{"kind": "BOUND", "op": "LTE", "value": {"type": "MONEY", "amount": "500000", "currency": "INR"}}]}, "must": "pass", "rule": "C-BOUND"}
{"id": "parser-008", "area": "parser", "lang": "en", "input": "Do not submit after Friday.", "expect": {"tier": 1, "facts": [{"kind": "NEG", "scope": "CLAUSE"}, {"kind": "TIMEREL", "rel": "AFTER", "anchor": {"type": "DATE", "weekday": 4}}]}, "must": "pass", "rule": "Clause scope"}
{"id": "parser-009", "area": "parser", "lang": "en", "input": "Submit by Friday.", "expect": {"tier": 1, "facts": [{"kind": "TIMEREL", "rel": "ON_OR_BEFORE", "anchor": {"type": "DATE", "weekday": 4}}], "flags": ["BY_UNTIL_AMBIGUOUS"]}, "must": "pass", "rule": "C-TIMEREL", "notes": "flag BY_UNTIL_AMBIGUOUS"}
{"id": "parser-010", "area": "parser", "lang": "en", "input": "Submit not after Friday.", "expect": {"tier": 1, "facts": [{"kind": "TIMEREL", "rel": "ON_OR_BEFORE", "anchor": {"type": "DATE", "weekday": 4}}]}, "must": "pass", "rule": "C-TIMEREL", "notes": "NEG(AFTER) is rewritten"}
{"id": "parser-011", "area": "parser", "lang": "en", "input": "If it rains, do not pay.", "expect": {"tier": 1, "facts": [{"kind": "NEG", "scope": "CLAUSE"}], "cond": "IF"}, "must": "pass", "rule": "Conditional", "notes": "clause 0 antecedent, clause 1 consequent"}
{"id": "parser-012", "area": "parser", "lang": "en", "input": "Do not pay unless you receive the invoice.", "expect": {"tier": 1, "facts": [{"kind": "NEG", "scope": "CLAUSE"}], "cond": "IF", "clause_polarities": ["NEG", "NEG"]}, "must": "pass", "rule": "C-UNLESS", "notes": "clause 1 (antecedent) has polarity NEG"}
{"id": "parser-013", "area": "parser", "lang": "en", "input": "The meeting starts at 10 AM.", "expect": {"tier": 1, "facts": [{"kind": "TIMEREL", "rel": "ON", "anchor": {"type": "TIME", "hour": 10, "minute": 0, "period": "AM"}}]}, "must": "pass", "rule": "NUM-11"}
