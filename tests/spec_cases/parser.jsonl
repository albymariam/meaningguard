{"id": "parser-016", "area": "parser", "lang": "en", "input": "Prices rose from ₹500 to ₹400.", "expect": {"tier": 1, "facts": [{"kind": "CHANGE", "direction": "FALL", "from": {"type": "MONEY", "amount": "500", "currency": "INR"}, "to": {"type": "MONEY", "amount": "400", "currency": "INR"}}], "diagnostics": ["SOURCE_INCONSISTENT"]}, "must": "pass", "rule": "C-DIR", "notes": "verb contradicts the numbers"}
